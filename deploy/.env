# 环境变量配置
# 部署模式：local 或 server
DEPLOY_MODE=${DEPLOY_MODE:-local}

# 根据部署模式加载环境变量
if [ "$DEPLOY_MODE" = "local" ]; then
  echo "Using local deployment mode..."
  if [ -f .env.local ]; then
    source .env.local
  else
    echo "Warning: .env.local not found, using default local configuration"
    # 默认本地配置
    export MYSQL_ROOT_PASSWORD=local_root
    export MYSQL_DATABASE=local_migration
    export MYSQL_USER=local_migration
    export MYSQL_PASSWORD=local_migration
    export SPRING_PROFILES_ACTIVE=dev
  fi
elif [ "$DEPLOY_MODE" = "server" ]; then
  echo "Using server deployment mode..."
  if [ -f .env.server ]; then
    source .env.server
  else
    echo "Warning: .env.server not found, using default server configuration"
    # 默认服务器配置
    export MYSQL_ROOT_PASSWORD=root
    export MYSQL_DATABASE=migration
    export MYSQL_USER=migration
    export MYSQL_PASSWORD=migration
    export SPRING_PROFILES_ACTIVE=prod
  fi
else
  echo "Error: Invalid deploy mode. Use 'local' or 'server'."
  exit 1
fi

# 这里可以添加全局环境变量，会覆盖上面的配置